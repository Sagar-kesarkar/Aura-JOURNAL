rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny: any path not explicitly matched below is forbidden
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolated user hierarchy strictly bound to the authenticated owner's UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's private journal entries
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's reflection interaction records
      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any nested subcollections strictly bound to this authenticated owner
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
