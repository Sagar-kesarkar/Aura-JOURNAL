# ==============================================================================
# Aura Journal Environment Specification
#
# ENVIRONMENT VARIABLE CLASSIFICATION:
#
# SECRETS (Must NEVER be committed or logged; inject via Secret Manager in Cloud Run):
#   - GEMINI_API_KEY
#
# NON-SECRET CONFIGURATION (Operational and environment metadata):
#   - GOOGLE_CLOUD_PROJECT
#   - ALLOWED_ORIGINS
#   - GEMINI_MODEL
#   - GEMINI_FALLBACK_MODELS
#   - APP_URL
#   - NODE_ENV
#   - PORT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRET CREDENTIALS (Injected via Google Cloud Secret Manager)
# ------------------------------------------------------------------------------
# Required for AI generation features. Kept exclusively on the backend server.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. REQUIRED OR SUPPLIED PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------
# Google Cloud Project ID (Required in production for Firebase Admin SDK token verification)
# In development/preview, will automatically discover from firebase-applet-config.json if unset.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Production CORS Allowlist (Required in production: comma-separated list of exact permitted origins)
# Example: https://journal.example.com,https://aura-journal-xyz-uc.a.run.app
ALLOWED_ORIGINS=https://your-cloud-run-domain

# Configured Primary Gemini Model (Supplied by environment or configured here; live availability not yet verified)
GEMINI_MODEL=gemini-3.8-flash

# Runtime Environment mode ('production', 'development', or 'test')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. OPTIONAL CONFIGURATION
# ------------------------------------------------------------------------------
# Configured Optional Fallback Models (Optional comma-separated list; leave unset if no fallback is desired)
# GEMINI_FALLBACK_MODELS=

# Canonical Application URL (Optional: used for canonical metadata and absolute links; NOT added to CORS)
# APP_URL=https://your-cloud-run-domain

# Server Port (Optional: Cloud Run automatically supplies 3000; defaults to 3000)
PORT=3000
